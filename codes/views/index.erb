<h1>ボウリングスコア管理システム</h1>

<h2>新しいゲームを開始</h2>
<form method="post" action="/games">
  <p>
    <label>プレーヤー名（カンマ区切り）:
      <input type="text" name="players" placeholder="くぼあき,うえはら" required>
    </label>
    <button type="submit" class="exec_btn">ゲーム開始</button>
  </p>
</form>

<h2>ゲーム履歴</h2>
<% if @games.empty? %>
  <p>まだゲームがありません。</p>
<% else %>
<table>
  <tr>
    <th class="itemname">ゲームID</th>
    <th class="itemname">開始日時</th>
    <th>プレーヤー</th>
    <th class="itemname">状態</th>
    <th class="itemname">操作</th>
  </tr>
  <% @games.each do |g| %>
  <tr>
    <td><%= g['game_id'] %></td>
    <td><%= g['play_date'] %></td>
    <td><%= g['players'] %></td>
    <td><%= g['status'] %></td>
    <td>
      <a href="/games/<%= g['game_id'] %>"><button type="button" class="exec_btn">表示</button></a>
      <form method="post" action="/games/<%= g['game_id'] %>/delete" style="display:inline;">
        <button type="submit" class="exec_btn" onclick="return confirm('削除しますか？')">削除</button>
      </form>
    </td>
  </tr>
  <% end %>
</table>
<% end %>
