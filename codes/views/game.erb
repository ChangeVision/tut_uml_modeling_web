<h1>ボウリングゲーム</h1>
<p><a href="/"><button type="button" class="exec_btn">← 戻る</button></a></p>

<% current_score = (@live && !@game.finished?) ? @game.scores[@game.turn] : nil %>
<% if @game.finished? %>
  <h2>ゲーム終了</h2>
<% elsif current_score %>
  <h2>現在のプレーヤー: <%= current_score.player %>（第<%= current_score.fno %>フレーム）</h2>
  <p>
    <% (0..max_pins(current_score)).each do |pins| %>
      <button type="button" class="exec_btn" onclick="play(<%= pins %>)"><%= pins %></button>
    <% end %>
  </p>
<% else %>
  <h2 class="alert">中断したゲームです（途中から再開することはできません）</h2>
<% end %>

<h2>スコアボード</h2>
<% current_fno = current_score && [current_score.fno, 10].min %>
<table>
  <tr>
    <th class="username">名前</th>
    <% (1..9).each do |fno| %>
      <th class="<%= fno == current_fno ? 'current' : '' %>" colspan="2"><%= fno %></th>
    <% end %>
    <th class="<%= current_fno == 10 ? 'current-ten' : 'ten' %>" colspan="3">10</th>
    <th class="total">Total</th>
  </tr>

  <% @game.scores.each do |score| %>
  <tr>
    <td class="username" rowspan="2"><%= score.player %></td>
    <% (1..9).each do |fno| %>
      <% frame = score.frame(fno) %>
      <td class="first"><%= first_mark(frame) %></td>
      <td class="second"><%= second_mark(frame) %></td>
    <% end %>
    <% c1, c2, c3 = tenth_marks(score) %>
    <td class="first"><%= c1 %></td>
    <td class="second"><%= c2 %></td>
    <td class="second"><%= c3 %></td>
    <td class="total" rowspan="2"><%= game_total(score) %></td>
  </tr>
  <tr>
    <% (1..10).each do |fno| %>
      <td class="score" colspan="<%= fno == 10 ? 3 : 2 %>"><%= frame_total(score.frame(fno)) %></td>
    <% end %>
  </tr>
  <% end %>
</table>

<% if current_score %>
<script>
function play(pins) {
  fetch('/games/<%= @game.id %>/play', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'pins=' + pins
  })
  .then(response => response.json())
  .then(data => {
    if (data.error) {
      alert(data.error);
    } else {
      location.reload();
    }
  })
  .catch(error => alert('エラーが発生しました: ' + error));
}
</script>
<% end %>
